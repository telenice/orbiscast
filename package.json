{
  "name": "orbiscast",
  "version": "1.4.0",
  "description": "Orbiscast project",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.4.0"
  },
  "overrides": {
    "unicorn-magic": "^0.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/sax": "^1.2.7",
    "@vitest/coverage-v8": "^5.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@dank074/discord-video-stream": "^7.0.0",
    "@lng2004/discord.js-selfbot-v13": "^3.7.2",
    "axios": "^1.20.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4",
    "lowdb": "^7.0.1",
    "sax": "^1.6.1",
    "winston": "^3.19.0"
  }
}
