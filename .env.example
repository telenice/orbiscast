# An example .env file for the IPTV Discord bot. Fill in the required variables and rename this file to .env.
# See README.md for more information on how to get these values.
#
# REQUIRED VARIABLES:
# - PLAYLIST: URL to your M3U playlist
#   OR XTREAM_HOST, XTREAM_USERNAME and XTREAM_PASSWORD for an Xtream Codes account
# - DISCORD_BOT_TOKEN: OAuth token for your Discord bot
# - DISCORD_USER_TOKEN: User token for Discord authentication
# - GUILD: Discord server/guild ID
#
# OPTIONAL VARIABLES:
# - XMLTV: URL to your XMLTV guide (enables programme information).
#   With Xtream, the provider's guide is used automatically when this is unset.
# - Other variables have default values and can be left commented if you want to use defaults

# System configuration, IPTV data
PLAYLIST="http://example.com/m3u/playlist.m3u"
XMLTV="http://example.com/xmltv/guide.xml"

# Xtream Codes API (use instead of, or together with, PLAYLIST)
# XTREAM_HOST="http://example.com:8080"
# XTREAM_USERNAME="username"
# XTREAM_PASSWORD="password"
# XTREAM_OUTPUT=ts                     # ts or m3u8
# XTREAM_CATEGORIES="UK | News,12"     # optional: category names or IDs to keep
# XTREAM_EPG=true                      # use the provider's xmltv.php when XMLTV is unset
# XMLTV_DAYS=3                         # days of upcoming guide listings to keep (0 = all)
# REFRESH_IPTV=1440
# RAM_CACHE=true
# CACHE_DIR=../cache
# DEBUG=false
# DEFAULT_STREAM_TIMEOUT=10
# MINIMIZE_LATENCY=true
# BITRATE_VIDEO=5000
# BITRATE_VIDEO_MAX=7500
# DISABLE_TRANSCODE=false

# Timezone configuration
#TZ="UTC"
# Example: TZ="Europe/Ljubljana"

# Discord bot data
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_USER_TOKEN="your_discord_user_token_here"
GUILD=000000000000000000